#!/bin/sh
# The houston CLI. Needs Bun (https://bun.sh); everything else is in .houston/src.
# Bun would otherwise load a bunfig.toml and a .env from the folder it runs in, which anyone who can
# push to the Houston repo (or a code repo) controls: --config names Houston's own empty bunfig.toml
# and --no-env-file turns .env loading off, so only reviewed code runs.
DIR=$(dirname "$0")
exec bun --no-env-file --config="$DIR/../bunfig.toml" "$DIR/../src/cli.ts" "$@"
